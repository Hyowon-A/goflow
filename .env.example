APP_ENV=development
HTTP_PORT=8081

DATABASE_URL=postgres://goflow:goflow@localhost:5433/goflow?sslmode=disable

REDIS_ADDR=localhost:6379
QUEUE_STREAM_NAME=goflow:tasks
QUEUE_CONSUMER_GROUP=goflow-workers
QUEUE_BLOCK_TIMEOUT=1s
QUEUE_READ_COUNT=1
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_RECOVERY_INTERVAL=30s
# Optional. If omitted, worker metrics HTTP is disabled.
# WORKER_METRICS_PORT=9091

# Optional. If omitted, GoFlow generates a stable process-local worker ID.
# WORKER_ID=worker-local-1
